{
  "version": 1,
  "limits": {
    "max_include_patterns": 32,
    "max_include_matches_per_pattern": 64,
    "max_include_files": 128,
    "max_yaml_file_bytes": 1048576,
    "max_yaml_aggregate_bytes": 8388608,
    "max_yaml_depth": 64,
    "max_yaml_nodes": 20000,
    "max_yaml_scalars": 12000,
    "max_task_scan_bytes": 2097152
  },
  "dynamic_markers": [
    "${",
    "{{"
  ],
  "windows_reserved_device_components": [
    "CON",
    "PRN",
    "AUX",
    "NUL",
    "COM1",
    "COM2",
    "COM3",
    "COM4",
    "COM5",
    "COM6",
    "COM7",
    "COM8",
    "COM9",
    "LPT1",
    "LPT2",
    "LPT3",
    "LPT4",
    "LPT5",
    "LPT6",
    "LPT7",
    "LPT8",
    "LPT9"
  ],
  "remote_prefixes": [
    "/Workspace/",
    "/Users/",
    "/Volumes/",
    "dbfs:/",
    "s3://",
    "abfss://",
    "abfs://",
    "wasbs://",
    "wasb://",
    "gs://",
    "adl://",
    "adlfs://",
    "hdfs://",
    "workspace://",
    "repos://",
    "volumes://",
    "uc://",
    "git://",
    "ssh://",
    "http://",
    "https://"
  ]
}
