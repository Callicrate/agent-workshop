{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.local/schemas/databricks-ml-training-config.json",
  "title": "Databricks ML Training Configuration",
  "description": "Closed, reproducible configuration for a point-in-time Databricks training run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["training", "model", "features", "target", "splits", "runtime", "outputs", "metrics", "threshold", "signature", "promotion", "provenance", "imbalance"],
  "properties": {
    "training": {"type": "object", "additionalProperties": false, "required": ["mode", "max_tuning_trials"], "properties": {"mode": {"type": "string", "enum": ["dev", "full"]}, "sample_cap": {"type": "integer", "minimum": 1}, "max_tuning_trials": {"type": "integer", "minimum": 0}}, "allOf": [{"if": {"properties": {"mode": {"const": "dev"}}, "required": ["mode"]}, "then": {"required": ["sample_cap"]}}]},
    "model": {"type": "object", "additionalProperties": false, "required": ["framework", "name", "hyperparameters"], "properties": {"framework": {"type": "string", "enum": ["xgboost", "lightgbm", "catboost", "sklearn", "spark_ml", "transformer"]}, "name": {"$ref": "#/$defs/loggedModelName"}, "hyperparameters": {"type": "array", "items": {"$ref": "#/$defs/hyperparameter"}, "uniqueItems": true}, "foundation_model": {"$ref": "#/$defs/nonemptyString"}}, "allOf": [{"if": {"properties": {"framework": {"const": "transformer"}}, "required": ["framework"]}, "then": {"required": ["foundation_model"]}}]},
    "features": {"type": "object", "additionalProperties": false, "required": ["columns", "feature_set_version", "schema_artifact"], "properties": {"columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/columnName"}}, "feature_set_version": {"$ref": "#/$defs/nonemptyString"}, "schema_artifact": {"$ref": "#/$defs/featureSchemaArtifact"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["column", "task_type"], "properties": {"column": {"$ref": "#/$defs/columnName"}, "positive_class": {"$ref": "#/$defs/classValue"}, "task_type": {"type": "string", "enum": ["binary", "multiclass"]}, "class_labels": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/classValue"}}}, "allOf": [{"if": {"properties": {"task_type": {"const": "binary"}}, "required": ["task_type"]}, "then": {"required": ["positive_class"], "not": {"required": ["class_labels"]}}}, {"if": {"properties": {"task_type": {"const": "multiclass"}}, "required": ["task_type"]}, "then": {"required": ["class_labels"], "not": {"required": ["positive_class"]}}}]},
    "splits": {"type": "object", "additionalProperties": false, "required": ["seed", "entity_key", "train", "validation", "test"], "properties": {"seed": {"type": "integer", "minimum": 0}, "entity_key": {"$ref": "#/$defs/columnName"}, "train": {"$ref": "#/$defs/window"}, "validation": {"$ref": "#/$defs/window"}, "test": {"$ref": "#/$defs/window"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["dbr", "python", "cluster_mode", "num_workers", "gpu_count", "requires_spark_table_import"], "properties": {"dbr": {"$ref": "#/$defs/nonemptyString"}, "python": {"$ref": "#/$defs/nonemptyString"}, "cluster_mode": {"type": "string", "enum": ["serverless", "job_cluster", "shared_cluster", "single_node_gpu"]}, "num_workers": {"type": "integer", "minimum": 0}, "gpu_count": {"type": "integer", "minimum": 0}, "requires_spark_table_import": {"type": "boolean"}, "distributed_training_mode": {"type": "string", "enum": ["none", "ddp", "accelerate", "spark"]}}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["artifact_root"], "properties": {"artifact_root": {"$ref": "#/$defs/nonemptyString"}, "project_root": {"$ref": "#/$defs/nonemptyString"}, "register_model": {"type": "boolean", "default": false}, "registered_model_name": {"$ref": "#/$defs/ucRegisteredModelName"}, "write_promotion_candidate": {"type": "boolean", "default": false}}, "allOf": [{"if": {"properties": {"register_model": {"const": true}}, "required": ["register_model"]}, "then": {"required": ["registered_model_name"]}}]},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["selection_metric", "direction", "required_slices"], "properties": {"selection_metric": {"$ref": "#/$defs/metric"}, "direction": {"$ref": "#/$defs/direction"}, "required_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sliceRequirement"}}}},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["enabled", "objective", "selection_split", "minimum_positive", "minimum_negative", "tie_break"], "properties": {"enabled": {"type": "boolean"}, "objective": {"type": "string", "enum": ["f1", "precision", "recall"]}, "selection_split": {"const": "validation"}, "minimum_positive": {"type": "integer", "minimum": 1}, "minimum_negative": {"type": "integer", "minimum": 1}, "tie_break": {"const": "lowest_threshold"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["input_example", "output_columns", "access_control_group", "retention_days"], "properties": {"input_example": {"$ref": "#/$defs/inputExample"}, "output_columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/columnName"}}, "access_control_group": {"$ref": "#/$defs/nonemptyString"}, "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650}}},
    "promotion": {"type": "object", "additionalProperties": false, "required": ["selection", "eligibility", "request_promotion"], "properties": {"selection": {"$ref": "#/$defs/selectionPolicy"}, "eligibility": {"$ref": "#/$defs/eligibilityPolicy"}, "request_promotion": {"type": "boolean", "default": false}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["sources", "example_timestamp_column", "git_commit", "job_id", "run_id", "idempotency_key", "run_started_at"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceSnapshot"}}, "example_timestamp_column": {"$ref": "#/$defs/columnName"}, "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}, "job_id": {"$ref": "#/$defs/identifier"}, "run_id": {"$ref": "#/$defs/identifier"}, "idempotency_key": {"$ref": "#/$defs/identifier"}, "run_started_at": {"type": "string", "format": "date-time"}}},
    "imbalance": {"$ref": "#/$defs/imbalance"}
  },
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1, "maxLength": 512},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "loggedModelName": {"type": "string", "allOf": [{"not": {"pattern": "[\\u0000-\\u001F\\u007F]"}}, {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}]},
    "ucRegisteredModelName": {"type": "string", "allOf": [{"not": {"pattern": "[\\u0000-\\u001F\\u007F`]"}}, {"pattern": "^(?:[^. /`\\u0000-\\u001F\\u007F]{1,255}\\.){2}[^. /`\\u0000-\\u001F\\u007F]{1,255}$"}]},
    "columnName": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
    "classValue": {"type": ["string", "number"]},
    "metric": {"type": "string", "enum": ["pr_auc", "roc_auc", "f1", "precision", "recall", "log_loss"]},
    "direction": {"type": "string", "enum": ["maximize", "minimize"]},
    "hyperparameter": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"$ref": "#/$defs/columnName"}, "value": {"type": ["string", "number", "integer", "boolean"]}}},
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "sliceRequirement": {"type": "object", "additionalProperties": false, "required": ["name", "minimum_support", "minimum_metric"], "properties": {"name": {"$ref": "#/$defs/nonemptyString"}, "minimum_support": {"type": "integer", "minimum": 1}, "minimum_metric": {"type": "number", "minimum": 0}}},
    "inputExample": {"type": "object", "additionalProperties": false, "required": ["kind", "max_rows", "columns"], "properties": {"kind": {"type": "string", "enum": ["synthetic", "redacted"]}, "max_rows": {"type": "integer", "minimum": 1, "maximum": 10}, "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/columnName"}}}},
    "selectionPolicy": {"type": "object", "additionalProperties": false, "required": ["metric", "direction", "split", "tie_break"], "properties": {"metric": {"$ref": "#/$defs/metric"}, "direction": {"$ref": "#/$defs/direction"}, "split": {"const": "validation"}, "tie_break": {"const": "candidate_id_ascending"}}},
    "eligibilityPolicy": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "required_mode": {"const": "full"}, "metric": {"$ref": "#/$defs/metric"}, "direction": {"$ref": "#/$defs/direction"}, "metric_threshold": {"type": "number", "minimum": 0}, "baseline_delta": {"type": "number", "minimum": 0}, "required_slices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sliceRequirement"}}, "calibration_max_error": {"type": "number", "minimum": 0, "maximum": 1}, "approval": {"$ref": "#/$defs/approval"}}, "allOf": [{"if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}, "then": {"required": ["required_mode", "metric", "direction", "metric_threshold", "baseline_delta", "required_slices", "calibration_max_error", "approval"]}}, {"if": {"properties": {"enabled": {"const": true}, "metric": {"enum": ["pr_auc", "roc_auc", "f1", "precision", "recall"]}}, "required": ["enabled", "metric"]}, "then": {"properties": {"baseline_delta": {"maximum": 1}}}}]},
    "approval": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"type": "string", "enum": ["not_requested", "pending", "approved", "rejected"]}, "reference": {"$ref": "#/$defs/nonemptyString"}}},
    "sourceSnapshot": {"type": "object", "additionalProperties": false, "required": ["role", "table", "delta_version", "delta_commit_id"], "properties": {"role": {"type": "string", "enum": ["examples", "features", "labels", "baseline"]}, "table": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"}, "delta_version": {"type": "integer", "minimum": 0}, "delta_commit_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}}},
    "schemaField": {"type": "object", "additionalProperties": false, "required": ["name", "logical_type", "nullable", "null_policy"], "properties": {"name": {"$ref": "#/$defs/columnName"}, "logical_type": {"type": "string", "enum": ["boolean", "integer", "long", "float", "double", "decimal", "string", "date", "timestamp", "array", "map", "struct", "binary"]}, "nullable": {"type": "boolean"}, "null_policy": {"type": "string", "enum": ["forbid", "impute", "indicator_and_impute", "model_native", "drop_row"]}}},
    "featureSchemaArtifact": {"type": "object", "additionalProperties": false, "required": ["version", "fingerprint", "features", "target"], "properties": {"version": {"$ref": "#/$defs/nonemptyString"}, "fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schemaField"}}, "target": {"$ref": "#/$defs/schemaField"}}},
    "classWeight": {"type": "object", "additionalProperties": false, "required": ["label", "weight"], "properties": {"label": {"$ref": "#/$defs/classValue"}, "weight": {"type": "number", "exclusiveMinimum": 0}}},
    "imbalance": {"type": "object", "additionalProperties": false, "required": ["strategy"], "properties": {"strategy": {"type": "string", "enum": ["none", "class_weight", "scale_pos_weight", "smote", "easy_ensemble", "pu_learning"]}, "scale_pos_weight": {"type": "number", "exclusiveMinimum": 0}, "class_weights": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/classWeight"}}, "smote_k_neighbors": {"type": "integer", "minimum": 1}}, "allOf": [{"if": {"properties": {"strategy": {"const": "scale_pos_weight"}}, "required": ["strategy"]}, "then": {"required": ["scale_pos_weight"]}, "else": {"not": {"required": ["scale_pos_weight"]}}}, {"if": {"properties": {"strategy": {"const": "class_weight"}}, "required": ["strategy"]}, "then": {"required": ["class_weights"]}, "else": {"not": {"required": ["class_weights"]}}}, {"if": {"properties": {"strategy": {"const": "smote"}}, "required": ["strategy"]}, "then": {"required": ["smote_k_neighbors"]}, "else": {"not": {"required": ["smote_k_neighbors"]}}}]}
  },
  "examples": [{
    "training": {"mode": "full", "sample_cap": 10000, "max_tuning_trials": 3},
    "model": {"framework": "xgboost", "name": "fraud_detector", "hyperparameters": [{"name": "max_depth", "value": 6}]},
    "features": {"columns": ["amount", "country_code"], "feature_set_version": "fraud_features_v4", "schema_artifact": {"version": "4", "fingerprint": "3aa71bc9f742f7356ef27a03318c5889d01d05fc537b70c2662c96ba72aea3da", "features": [{"name": "amount", "logical_type": "double", "nullable": false, "null_policy": "forbid"}, {"name": "country_code", "logical_type": "string", "nullable": true, "null_policy": "indicator_and_impute"}], "target": {"name": "label", "logical_type": "string", "nullable": false, "null_policy": "forbid"}}},
    "target": {"column": "label", "positive_class": "fraud", "task_type": "binary"},
    "splits": {"seed": 42, "entity_key": "transaction_id", "train": {"start": "2025-01-01T00:00:00Z", "end": "2025-02-01T00:00:00Z"}, "validation": {"start": "2025-02-01T00:00:00Z", "end": "2025-02-15T00:00:00Z"}, "test": {"start": "2025-02-15T00:00:00Z", "end": "2025-03-01T00:00:00Z"}},
    "runtime": {"dbr": "16.4.x-cpu-ml-scala2.12", "python": "3.11", "cluster_mode": "job_cluster", "num_workers": 2, "gpu_count": 0, "requires_spark_table_import": true, "distributed_training_mode": "spark"},
    "outputs": {"artifact_root": "/Volumes/main/ml_models/artifacts/fraud", "register_model": false, "write_promotion_candidate": false},
    "metrics": {"selection_metric": "pr_auc", "direction": "maximize", "required_slices": [{"name": "global", "minimum_support": 50, "minimum_metric": 0.1}]},
    "threshold": {"enabled": true, "objective": "f1", "selection_split": "validation", "minimum_positive": 5, "minimum_negative": 5, "tie_break": "lowest_threshold"},
    "signature": {"input_example": {"kind": "synthetic", "max_rows": 3, "columns": ["amount", "country_code"]}, "output_columns": ["prediction", "probability"], "access_control_group": "ml-model-readers", "retention_days": 90},
    "promotion": {"selection": {"metric": "pr_auc", "direction": "maximize", "split": "validation", "tie_break": "candidate_id_ascending"}, "eligibility": {"enabled": true, "required_mode": "full", "metric": "pr_auc", "direction": "maximize", "metric_threshold": 0.2, "baseline_delta": 0.01, "required_slices": [{"name": "global", "minimum_support": 50, "minimum_metric": 0.1}], "calibration_max_error": 0.05, "approval": {"status": "approved", "reference": "ML-123"}}, "request_promotion": false},
    "provenance": {"sources": [{"role": "examples", "table": "main.ml_models.training_examples", "delta_version": 123, "delta_commit_id": "20250101-001"}, {"role": "features", "table": "main.ml_models.features_scd2", "delta_version": 456, "delta_commit_id": "20250101-002"}], "example_timestamp_column": "example_at", "git_commit": "abc1234", "job_id": "12345", "run_id": "67890", "idempotency_key": "fraud-2025-03-01-full-v1", "run_started_at": "2025-03-01T00:00:00Z"},
    "imbalance": {"strategy": "scale_pos_weight", "scale_pos_weight": 25.0}
  }]
}
