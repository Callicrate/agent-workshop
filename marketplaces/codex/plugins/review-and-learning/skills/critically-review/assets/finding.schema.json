{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critical Review Finding",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "issue_type",
    "severity",
    "confidence",
    "quote",
    "location",
    "analysis",
    "why_it_matters",
    "evidence",
    "recommended_fix",
    "observed_evidence",
    "decision_impact",
    "repair_shape",
    "verification_needed"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^F-[0-9]{3,}$", "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 10000},
    "category": {
      "type": "string",
      "enum": ["factuality", "omission", "reasoning", "source-quality", "methodology", "data", "benchmark", "code", "architecture", "feasibility", "recommendation", "framing"]
    },
    "issue_type": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "note"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "evidence_quality": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "quote": {"type": "string", "minLength": 1, "maxLength": 10000},
    "location": {"type": "string", "minLength": 1, "maxLength": 10000},
    "analysis": {"type": "string", "minLength": 1, "maxLength": 10000},
    "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 10000},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["source_type", "reference", "notes"],
        "properties": {
          "source_type": {"type": "string", "enum": ["artifact", "repository", "runtime", "primary-source", "secondary-source", "user-provided", "generated-artifact", "other"]},
          "reference": {"type": "string", "minLength": 1, "maxLength": 10000},
          "notes": {"type": "string", "minLength": 1, "maxLength": 10000}
        },
        "additionalProperties": false
      }
    },
    "recommended_fix": {"type": "string", "minLength": 1, "maxLength": 10000},
    "observed_evidence": {"type": "string", "minLength": 1, "maxLength": 10000},
    "decision_impact": {"type": "string", "minLength": 1, "maxLength": 10000},
    "repair_shape": {"type": "string", "minLength": 1, "maxLength": 10000},
    "verification_needed": {"type": "string", "minLength": 1, "maxLength": 10000},
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["source_id", "source", "finding_id"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source-[a-f0-9]{16}$"},
          "source": {"type": "string", "pattern": "^[^/\\\\\r\n]{1,128}$"},
          "finding_id": {"type": "string", "pattern": "^F-[0-9]{3,}$", "maxLength": 64}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
